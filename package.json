{
  "name": "thank-you-learning",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "node scripts/expo.mjs start",
    "web": "node scripts/expo.mjs start --web --host localhost",
    "build:web": "node scripts/expo.mjs export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "content:probe": "python3 scripts/content_pipeline.py probe",
    "content:import-official": "python3 scripts/import_official_lists.py",
    "content:plan-words": "python3 scripts/build_word_plan.py",
    "content:audit": "python3 scripts/content_pipeline.py audit",
    "content:release-check": "python3 scripts/content_pipeline.py audit --release",
    "content:analyze": "python3 scripts/analyze_corpus.py",
    "test:content": "python3 -m unittest discover -s tests -p \"test_*.py\" -v",
    "content:reading-batch": "python3 scripts/build_advanced_readings.py",
    "content:reading-quality": "python3 scripts/reading_quality.py"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "^0.83.10",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
